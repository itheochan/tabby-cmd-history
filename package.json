    "@angular/forms": "^15.2.0",
    "@ng-bootstrap/ng-bootstrap": "^14.1.0",
    "rxjs": "^7.5.0",
    "tabby-core": ">=1.0.231-nightly.0 <2",
    "tabby-settings": ">=1.0.231-nightly.0 <2",
    "tabby-terminal": ">=1.0.231-nightly.0 <2"
  },
  "devDependencies": {
    "@angular/common": "^15.2.6",
    "@angular/core": "^15.2.6",
    "@angular/forms": "^15.2.6",
    "@ng-bootstrap/ng-bootstrap": "^14.1.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.17.0",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "apply-loader": "^2.0.0",
    "css-loader": "^6.10.0",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "pug": "^3.0.4",
    "pug-loader": "^1.0.2",
    "rxjs": "^7.5.7",
    "sass": "^1.77.0",
    "sass-loader": "^13.3.3",
    "style-loader": "^3.3.4",
    "tabby-core": "1.0.231-nightly.0",
    "tabby-settings": "1.0.231-nightly.0",
    "tabby-terminal": "1.0.231-nightly.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.1",
    "typescript": "4.9.5",
    "webpack": "^5.90.0",
    "webpack-cli": "^5.1.4"
